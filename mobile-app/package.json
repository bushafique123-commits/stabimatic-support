{
  "name": "stabimatic-mobile",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "start": "ionic serve",
    "start:web": "node scripts/serve-web.mjs",
    "build": "ng build",
    "build:android": "ng build --configuration android",
    "release:set-api": "node scripts/set-production-api.mjs",
    "release:check": "node scripts/assert-release-config.mjs",
    "deploy:api:check": "php ../api/console/validate-production-env.php",
    "deploy:admin:check": "php ../admin/console/validate-production-env.php",
    "deploy:production:check": "node scripts/deploy-production-check.mjs",
    "android:signing:check": "node scripts/assert-android-signing.mjs",
    "test": "ng test",
    "cap:sync": "npx cap sync",
    "android:add": "npx cap add android",
    "android:sync": "npm run build && npx cap sync android",
    "android:sync:dev": "npm run build:android && npx cap sync android",
    "android:sync:release": "npm run release:check && npm run build && npx cap sync android",
    "android:open": "npx cap open android",
    "android:debug": "npm run build && npx cap run android",
    "android:run:dev": "npm run android:sync:dev && npx cap run android",
    "android:devices": "node scripts/android-device-qa.mjs devices",
    "android:qa:preflight": "node scripts/android-device-qa.mjs preflight",
    "android:install:debug": "node scripts/android-device-qa.mjs install-debug",
    "android:logs": "node scripts/android-device-qa.mjs logs",
    "android:qa:full": "npm run android:sync:dev && npm run android:assemble:debug && npm run android:qa:preflight && npm run android:install:debug",
    "android:store:check": "node scripts/android-store-check.mjs",
    "android:assemble:debug": "cd android && gradlew.bat assembleDebug",
    "android:assemble:unsigned": "cd android && gradlew.bat assembleRelease",
    "android:assemble:release": "npm run release:check && npm run android:signing:check && cd android && gradlew.bat assembleRelease",
    "android:bundle:release": "npm run release:check && npm run android:signing:check && cd android && gradlew.bat bundleRelease",
    "android:release:candidate": "npm run android:sync:release && npm run android:signing:check && cd android && gradlew.bat assembleRelease"
  },
  "dependencies": {
    "@angular/animations": "^17.0.0",
    "@angular/common": "^17.0.0",
    "@angular/compiler": "^17.0.0",
    "@angular/core": "^17.0.0",
    "@angular/forms": "^17.0.0",
    "@angular/platform-browser": "^17.0.0",
    "@angular/platform-browser-dynamic": "^17.0.0",
    "@angular/router": "^17.0.0",
    "@capacitor/android": "^6.0.0",
    "@capacitor/app": "^6.0.0",
    "@capacitor/camera": "^6.0.0",
    "@capacitor/core": "^6.0.0",
    "@capacitor/device": "^6.0.0",
    "@capacitor/ios": "^6.0.0",
    "@capacitor/network": "^6.0.0",
    "@capacitor/preferences": "^6.0.0",
    "@ionic/angular": "^8.0.0",
    "ionicons": "^7.0.0",
    "rxjs": "^7.8.0",
    "tslib": "^2.6.0",
    "zone.js": "^0.14.0"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^17.0.0",
    "@angular/cli": "^17.0.0",
    "@angular/compiler-cli": "^17.0.0",
    "@capacitor/cli": "^6.0.0",
    "@ionic/angular-toolkit": "^11.0.0",
    "typescript": "~5.2.0"
  }
}
