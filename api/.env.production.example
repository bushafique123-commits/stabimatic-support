APP_ENV=production
APP_DEBUG=false
APP_URL=https://stabimatic.techxaz.com
API_URL=https://stabimatic.techxaz.com/api

DB_HOST=localhost
DB_NAME=stabimatic
DB_USER=stabimatic_user
DB_PASSWORD=change-this-database-password

JWT_SECRET=change-this-to-a-random-production-secret-at-least-32-characters
JWT_EXPIRY=2592000

CORS_ALLOWED_ORIGINS=*

OTP_EXPIRY_MINUTES=10
OTP_RESEND_SECONDS=60
OTP_MAX_ATTEMPTS=5
OTP_EXPOSE_IN_RESPONSE=false

SMS_PROVIDER=sendpk
SENDPK_API_URL=https://sendpk.com/api/sms.php
SENDPK_API_KEY=change-this-sendpk-api-key
SENDPK_SENDER=8584
SENDPK_OTP_TEMPLATE_ID=change-this-approved-otp-template-id
SENDPK_OTP_MESSAGE_TEMPLATE={"otp":"{otp}"}
SENDPK_NOTIFICATION_TEMPLATE_ID=change-this-approved-notification-template-id
SENDPK_NOTIFICATION_MESSAGE_TEMPLATE={"title":"{title}","message":"{message}"}
SENDPK_TIMEOUT_SECONDS=15

PUSH_PROVIDER=fcm
FCM_ENDPOINT=https://fcm.googleapis.com/fcm/send
FCM_SERVER_KEY=change-this-fcm-server-key
FCM_TIMEOUT_SECONDS=15
NOTIFICATION_DELIVERY_BATCH_SIZE=50

SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=change-this-smtp-user
SMTP_PASSWORD=change-this-smtp-password
SMTP_FROM_EMAIL=no-reply@example.com
SMTP_FROM_NAME=STABIMATIC

MAX_UPLOAD_BYTES=5242880
UPLOAD_PATH=uploads/installations
