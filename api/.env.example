APP_ENV=development
APP_DEBUG=true
APP_URL=http://localhost/stabimatic
API_URL=http://localhost/stabimatic/api

DB_HOST=localhost
DB_NAME=stabimatic
DB_USER=root
DB_PASSWORD=

JWT_SECRET=CHANGE_THIS_SECRET
JWT_EXPIRY=2592000

CORS_ALLOWED_ORIGINS=*

OTP_EXPIRY_MINUTES=10
OTP_RESEND_SECONDS=60
OTP_MAX_ATTEMPTS=5
OTP_EXPOSE_IN_RESPONSE=false

SMS_PROVIDER=dummy
SENDPK_API_URL=https://sendpk.com/api/sms.php
SENDPK_API_KEY=
SENDPK_SENDER=8584
SENDPK_OTP_TEMPLATE_ID=
SENDPK_OTP_MESSAGE_TEMPLATE={"code":"{otp}","contact":"your-support-contact"}
SENDPK_NOTIFICATION_TEMPLATE_ID=
SENDPK_NOTIFICATION_MESSAGE_TEMPLATE={"title":"{title}","message":"{message}"}
SENDPK_TIMEOUT_SECONDS=15

PUSH_PROVIDER=log
FCM_ENDPOINT=https://fcm.googleapis.com/fcm/send
FCM_SERVER_KEY=
FCM_TIMEOUT_SECONDS=15
NOTIFICATION_DELIVERY_BATCH_SIZE=50

SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=no-reply@stabimatic.local
SMTP_FROM_NAME=STABIMATIC

MAX_UPLOAD_BYTES=5242880
UPLOAD_PATH=uploads/installations
